{
  "name": "turno-core",
  "version": "0.3.0",
  "description": "Shared building blocks of turno-cli and turno-browser: XDG paths, the OS secret store (macOS Keychain, Linux Secret Service), process helpers and the command line toolkit.",
  "license": "Apache-2.0",
  "author": "William Frank Monroy Mamani (https://github.com/william-monroy)",
  "homepage": "https://turno.wimo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wimo-dev/turno.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/wimo-dev/turno/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./secrets": {
      "types": "./dist/secrets.d.ts",
      "default": "./dist/secrets.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./dist/process.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./cli/*": {
      "types": "./dist/cli/*.d.ts",
      "default": "./dist/cli/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build && cp ../../LICENSE ../../NOTICE ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "turno",
    "keychain",
    "secret-service",
    "xdg"
  ]
}
