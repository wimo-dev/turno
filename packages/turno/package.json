{
  "name": "turno-cli",
  "version": "0.5.3",
  "description": "Switch accounts in your coding agents and keep the conversation, the MCP sign-ins and the browser session.",
  "keywords": [
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "mcp",
    "model-context-protocol",
    "mcp-gateway",
    "ai-agents",
    "coding-agents",
    "cli",
    "statusline",
    "profiles",
    "developer-tools"
  ],
  "license": "Apache-2.0",
  "author": "William Frank Monroy Mamani (https://github.com/william-monroy)",
  "homepage": "https://turno.wimo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wimo-dev/turno.git",
    "directory": "packages/turno"
  },
  "bugs": {
    "url": "https://github.com/wimo-dev/turno/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "bin": {
    "turno": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "npm-shrinkwrap.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "TURNO_E2E_NETWORK=1 vitest run test/e2e-*.test.ts",
    "prepack": "pnpm run build && node ../../scripts/shrinkwrap.mjs . && node ../../scripts/readme-for-npm.mjs README.md && cp ../../LICENSE ../../NOTICE ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "smol-toml": "1.9.1",
    "turno-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "turno-browser": "workspace:*",
    "turno-fonts": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
