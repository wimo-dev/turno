{
  "name": "turno-browser",
  "version": "0.11.1",
  "description": "A browser your agents use with your accounts. It stays light on your machine, and the model never sees your passwords.",
  "license": "Apache-2.0",
  "author": "William Frank Monroy Mamani (https://github.com/william-monroy)",
  "homepage": "https://turno.wimo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wimo-dev/turno.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/wimo-dev/turno/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "turno-browser": "dist/cli/main.js",
    "turno-browser-mcp": "dist/bin/mcp.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "npm-shrinkwrap.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin/mcp.js dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build && node ../../scripts/shrinkwrap.mjs . && cp ../../LICENSE ../../NOTICE ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "patchright-core": "1.64.3",
    "turno-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "browser",
    "chrome",
    "browser-automation",
    "ai-agents",
    "coding-agents",
    "browser-identities",
    "signed-in-sessions",
    "credential-vault",
    "playwright"
  ],
  "mcpName": "io.github.wimo-dev/turno-browser"
}
