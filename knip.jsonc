{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "bench/*.mjs", "bench/browser/*.mjs"],
      "project": ["scripts/*.mjs", "bench/**/*.mjs"]
    },
    "packages/turno": {
      // demo/server.ts runs as its own process (turno demo starts it by path).
      "entry": ["src/cli/main.ts", "src/demo/server.ts", "test/**/*.test.ts", "test/fixtures/**"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/browser": {
      "entry": ["src/index.ts", "src/bin/mcp.ts", "src/cli/main.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // The camoufox engine loads the user's own playwright-core at run time; never a dependency.
      "ignoreDependencies": ["playwright-core"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "src/paths.ts", "src/secrets.ts", "src/process.ts", "src/memory.ts", "src/cli/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/fonts": {}
  },
  // The documentation site is a Next.js app with its own build and checks (docs.yml).
  "ignoreWorkspaces": ["apps/docs"],
  // The Codex end-to-end test runs the real binary when it is installed.
  "ignoreBinaries": ["codex"]
}
